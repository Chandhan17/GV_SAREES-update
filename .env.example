# Firebase Web app configuration. These values are safe for the browser,
# but must belong to the independent GV Sarees Firebase project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Comma-separated email addresses allowed to use the admin UI.
VITE_IMAGE_UPLOAD_ENDPOINT=/api/upload-image
VITE_ADMIN_EMAILS=
VITE_API_BASE_URL=
# Public checkout key; configure with an rzp_test_ key matching RAZORPAY_KEY_ID.
VITE_RAZORPAY_KEY_ID=

# Server-only test-mode configuration. Never prefix the secret with VITE_ or
# expose it in frontend code, browser bundles, or public repositories.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=
RESERVATION_TOKEN_SECRET=
CRON_SECRET=

# Optional local tunnel host used by Vite during remote testing.
VITE_NGROK_HOST=

# Optional migration-script alternatives. Do not use these in the browser.
FIREBASE_SERVICE_ACCOUNT_FILE=
GCLOUD_PROJECT=
