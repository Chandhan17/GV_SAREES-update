    "benchmark:baseline": "node scripts/performanceBenchmark.mjs --mode baseline",
    "benchmark:compare": "node scripts/performanceBenchmark.mjs --mode compare",
    "benchmark:load": "node scripts/performanceBenchmark.mjs --mode load",
    "build": "vite build",
    "lint": "eslint .",
    "test": "node --test tests/*.test.js",
    "preview": "vite preview",
