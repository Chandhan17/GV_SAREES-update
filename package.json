    "autocannon": "^9.0.0",
    "autoprefixer": "^10.4.27",
    "chrome-launcher": "^1.2.3",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "lighthouse": "^12.8.2",
