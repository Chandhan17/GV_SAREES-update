{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/|@vite/|@react-refresh|src/|shared/|node_modules/|@id/|@fs/|.*\\.[A-Za-z0-9]+$).*)",
      "destination": "/index.html"
    }
  ]
}
